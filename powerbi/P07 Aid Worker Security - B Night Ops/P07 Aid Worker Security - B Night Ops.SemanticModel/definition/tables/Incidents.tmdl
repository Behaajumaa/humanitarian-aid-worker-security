	partition Incidents = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Desktop\Data Analysis Projects\07_Humanitarian_Aid_Analysis\data\clean\fact_incidents.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"incident_id", "year", "month", "incident_date", "date_precision", "country_code", "country", "admin1", "un", "ingo", "icrc", "nrcs_and_ifrc", "nngo", "other", "main_org_type", "nationals_killed", "nationals_wounded", "nationals_kidnapped", "total_nationals", "internationals_killed", "internationals_wounded", "internationals_kidnapped", "total_internationals", "total_killed", "total_wounded", "total_kidnapped", "total_affected", "means_of_attack", "attack_category", "attack_context", "location_type", "latitude", "longitude", "motive", "actor_type", "actor_group", "verified", "source", "is_partial_year", "dq_flag"}),
				    Blanks = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"incident_id", "year", "month", "incident_date", "date_precision", "country_code", "country", "admin1", "un", "ingo", "icrc", "nrcs_and_ifrc", "nngo", "other", "main_org_type", "nationals_killed", "nationals_wounded", "nationals_kidnapped", "total_nationals", "internationals_killed", "internationals_wounded", "internationals_kidnapped", "total_internationals", "total_killed", "total_wounded", "total_kidnapped", "total_affected", "means_of_attack", "attack_category", "attack_context", "location_type", "latitude", "longitude", "motive", "actor_type", "actor_group", "verified", "source", "is_partial_year", "dq_flag"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"incident_id", Int64.Type}, {"year", Int64.Type}, {"month", Int64.Type}, {"incident_date", type date}, {"date_precision", type text}, {"country_code", type text}, {"country", type text}, {"admin1", type text}, {"un", Int64.Type}, {"ingo", Int64.Type}, {"icrc", Int64.Type}, {"nrcs_and_ifrc", Int64.Type}, {"nngo", Int64.Type}, {"other", Int64.Type}, {"main_org_type", type text}, {"nationals_killed", Int64.Type}, {"nationals_wounded", Int64.Type}, {"nationals_kidnapped", Int64.Type}, {"total_nationals", Int64.Type}, {"internationals_killed", Int64.Type}, {"internationals_wounded", Int64.Type}, {"internationals_kidnapped", Int64.Type}, {"total_internationals", Int64.Type}, {"total_killed", Int64.Type}, {"total_wounded", Int64.Type}, {"total_kidnapped", Int64.Type}, {"total_affected", Int64.Type}, {"means_of_attack", type text}, {"attack_category", type text}, {"attack_context", type text}, {"location_type", type text}, {"latitude", type number}, {"longitude", type number}, {"motive", type text}, {"actor_type", type text}, {"actor_group", type text}, {"verified", type text}, {"source", type text}, {"is_partial_year", Int64.Type}, {"dq_flag", type text}}, "en-US"),
				    GeoCell = Table.AddColumn(Typed, "geo_cell", each if [latitude] = null or [longitude] = null then null else Number.ToText(Number.Round([latitude] / 1.5) * 1.5, "0.0", "en-US") & "|" & Number.ToText(Number.Round([longitude] / 1.5) * 1.5, "0.0", "en-US"), type text)
				in
