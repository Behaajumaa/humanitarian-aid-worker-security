table Incidents
	lineageTag: fe676574-0896-42d2-b5c7-e098021b0a32

	measure Incidents = COUNTROWS(Incidents)
		formatString: #,0
		displayFolder: KPI
		lineageTag: 16bb94e3-78e0-468e-8468-fd099c996c7d

	measure Affected = SUM(Incidents[total_affected])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 187da920-357c-4531-9d09-16808483325e

	measure Killed = SUM(Incidents[total_killed])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 6a69544d-7d61-44de-9566-560c07f5dfb9

	measure Wounded = SUM(Incidents[total_wounded])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 59eae65a-a6a2-4ab5-a4b9-ca3d4e530290

	measure Kidnapped = SUM(Incidents[total_kidnapped])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 878cab25-9406-4cb6-baeb-619975fc46f9

	measure 'Not Killed' = [Affected] - [Killed]
		formatString: #,0
		displayFolder: KPI
		lineageTag: 9b1c32f3-0d48-46db-9871-1b594d8eec07

	measure 'Fatality Rate' = DIVIDE([Killed], [Affected])
		formatString: 0%
		displayFolder: KPI
		lineageTag: 53e7f7b9-fa8b-48a6-8049-6a4e2c13bc32

	measure Countries = CALCULATE(DISTINCTCOUNT(Incidents[country]), Incidents[country] <> "Unknown")
		formatString: #,0
		displayFolder: KPI
		lineageTag: 5852790f-2f0e-4681-8496-0aac3ad6e020

	measure 'National Staff %' = DIVIDE(SUM(Incidents[total_nationals]), [Affected])
		formatString: 0%
		displayFolder: Staff
		lineageTag: b000c1bd-9e3d-4678-8e5a-8aa5e0712009

	measure 'International Staff %' = DIVIDE(SUM(Incidents[total_internationals]), [Affected])
		formatString: 0%
		displayFolder: Staff
		lineageTag: 7ba5aaf7-9144-4e61-b155-704778499a52

	measure 'National Deaths %' = DIVIDE(SUM(Incidents[nationals_killed]), [Killed])
		formatString: 0%
		displayFolder: Staff
		lineageTag: 60e609bf-b21c-46c6-929a-34184070e785

	measure 'International Deaths %' = DIVIDE(SUM(Incidents[internationals_killed]), [Killed])
		formatString: 0%
		displayFolder: Staff
		lineageTag: 069a3f0e-8ae8-4f89-8601-b68a9a4a95fc

	measure 'National by Outcome' = SWITCH(SELECTEDVALUE(Outcome[Outcome]), "Killed", SUM(Incidents[nationals_killed]), "Wounded", SUM(Incidents[nationals_wounded]), "Kidnapped", SUM(Incidents[nationals_kidnapped]))
		formatString: #,0
		displayFolder: Staff
		lineageTag: aaeaa62c-986b-4233-8cf9-67447699955c

	measure 'National by Outcome (Left)' = -[National by Outcome]
		formatString: #,0;#,0
		displayFolder: Staff
		lineageTag: d8353fa4-30b7-4447-bf36-3e94b2bbbd6a

	measure 'International by Outcome' = SWITCH(SELECTEDVALUE(Outcome[Outcome]), "Killed", SUM(Incidents[internationals_killed]), "Wounded", SUM(Incidents[internationals_wounded]), "Kidnapped", SUM(Incidents[internationals_kidnapped]))
		formatString: #,0
		displayFolder: Staff
		lineageTag: 6c046db7-8505-4989-a599-d8396721215c

	measure 'Country Rank' = IF(ISINSCOPE(Incidents[country]), RANKX(ALLSELECTED(Incidents[country]), [Affected], , DESC, Dense))
		formatString: 0
		displayFolder: Where
		lineageTag: fbf10b40-72d6-485e-afac-914981c60f3b

	measure 'Affected Top7' = IF([Country Rank] <= 7, [Affected])
		formatString: #,0
		displayFolder: Where
		lineageTag: 7e288f70-be5f-430a-b5e6-b9891cb4b638

	measure 'Killed Top7' = IF([Country Rank] <= 7, [Killed])
		formatString: #,0
		displayFolder: Where
		lineageTag: 5d17d187-4832-43b8-8d17-04898e8a7b45

	measure 'Survived Top7' = IF([Country Rank] <= 7, [Not Killed])
		formatString: #,0
		displayFolder: Where
		lineageTag: a2ea2bc4-2f16-46b6-aa99-ab1578e35e13

	measure 'Avg Latitude' = AVERAGE(Incidents[latitude])
		formatString: 0.00
		displayFolder: Where
		lineageTag: be2fe3ed-b417-4923-809e-ebb69df95abf

	measure 'Avg Longitude' = AVERAGE(Incidents[longitude])
		formatString: 0.00
		displayFolder: Where
		lineageTag: 41245c46-478d-447f-93dc-8d16383247d7

	measure 'Affected Known Type' = IF(SELECTEDVALUE(Incidents[attack_category]) <> "Unknown", [Affected])
		formatString: #,0
		displayFolder: How
		lineageTag: 7d1fda73-fd62-49c5-851a-f7a51c7df6a6

	measure 'Killed % Known Type' = IF(SELECTEDVALUE(Incidents[attack_category]) <> "Unknown", DIVIDE([Killed], [Affected]))
		formatString: 0%
		displayFolder: How
		lineageTag: 47f39e9d-cb2b-4a19-bf0b-4947e3b56d97

	measure 'Wounded % Known Type' = IF(SELECTEDVALUE(Incidents[attack_category]) <> "Unknown", DIVIDE([Wounded], [Affected]))
		formatString: 0%
		displayFolder: How
		lineageTag: f3cf5b4c-7726-4d6a-9c2f-46658d9c1817

	measure 'Kidnapped % Known Type' = IF(SELECTEDVALUE(Incidents[attack_category]) <> "Unknown", DIVIDE([Kidnapped], [Affected]))
		formatString: 0%
		displayFolder: How
		lineageTag: d0058593-e481-4b81-8357-3638d783b8f5

	measure 'Road Share' = DIVIDE(CALCULATE([Affected], Incidents[location_type] = "Road"), [Affected])
		formatString: 0%
		displayFolder: How
		lineageTag: 8824b8ce-0c2b-4606-9425-8ca77f49e376

	measure 'Ambush Share' = DIVIDE(CALCULATE([Affected], Incidents[attack_context] = "Ambush"), [Affected])
		formatString: 0%
		displayFolder: How
		lineageTag: f1698bdd-34ed-4842-92e7-089ddba5ab25

	measure 'Actor Share' = DIVIDE([Affected], CALCULATE([Affected], ALLSELECTED(Incidents[actor_group])))
		formatString: 0%
		displayFolder: Who
		lineageTag: 60ae451c-486d-4ff4-aa36-50b2266b9e91

	measure 'Org Victims' = SWITCH(SELECTEDVALUE('Org Type'[Org]), "INGO", SUM(Incidents[ingo]), "National NGO", SUM(Incidents[nngo]), "UN", SUM(Incidents[un]), "Red Cross / Crescent & other", SUM(Incidents[icrc]) + SUM(Incidents[nrcs_and_ifrc]) + SUM(Incidents[other]))
		formatString: #,0
		displayFolder: Who
		lineageTag: bda93831-0b3a-4fd3-9909-23bf925388a1

	measure 'Org Share' = DIVIDE([Org Victims], SUM(Incidents[ingo]) + SUM(Incidents[nngo]) + SUM(Incidents[un]) + SUM(Incidents[icrc]) + SUM(Incidents[nrcs_and_ifrc]) + SUM(Incidents[other]))
		formatString: 0%
		displayFolder: Who
		lineageTag: 36e08c10-91cd-4d45-9a2d-f3253c548f0d

	measure 'Note Countries' = "in " & FORMAT([Countries], "#,0") & " countries"
		displayFolder: Notes
		lineageTag: dd3e2c3e-2510-4032-aa62-382fa320b150

	measure 'Note Countries Short' = FORMAT([Countries], "#,0") & " countries"
		displayFolder: Notes
		lineageTag: 095875a7-27a4-4c40-8752-c0bf001a9296

	measure 'Note Fatality' = FORMAT([Fatality Rate], "0%") & " fatality"
		displayFolder: Notes
		lineageTag: d3b3a69b-d778-418f-a7d6-7ec9b14ad3c8

	measure 'Note Road' = "attacked on the road · " & FORMAT([Ambush Share], "0%") & " in ambushes"
		displayFolder: Notes
		lineageTag: 28f9cb8a-0e62-48d8-a097-0452a63257f1

	measure 'Note Peak Affected' = VAR t = TOPN(1, ADDCOLUMNS(VALUES(Incidents[year]), "@v", [Affected]), [@v], DESC) RETURN IF(NOT ISEMPTY(t), "record " & FORMAT(MAXX(t, [@v]), "#,0") & " in " & MAXX(t, Incidents[year]))
		displayFolder: Notes
		lineageTag: 4d2918ee-fffc-459d-9fbb-12e7d990d121

	measure 'Note Peak Killed' = VAR t = TOPN(1, ADDCOLUMNS(VALUES(Incidents[year]), "@v", [Killed]), [@v], DESC) RETURN IF(NOT ISEMPTY(t), "peak " & FORMAT(MAXX(t, [@v]), "#,0") & " in " & MAXX(t, Incidents[year]))
		displayFolder: Notes
		lineageTag: a43d3609-0a51-4b64-b854-ec1225d25875

	measure 'Note Latest Fatality' = VAR y = MAX(Incidents[year]) RETURN FORMAT(CALCULATE([Fatality Rate], Incidents[year] = y), "0%") & " in " & y
		displayFolder: Notes
		lineageTag: 1c9c60cc-743c-4f42-ab8e-59fe5af1bb9e

	measure 'Note National' = "of victims · " & FORMAT([National Deaths %], "0%") & " of deaths"
		displayFolder: Notes
		lineageTag: 48c5f9b4-a934-4c17-9c26-9b54175e31ec

